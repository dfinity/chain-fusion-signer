#!/usr/bin/env bash
set -euo pipefail

[[ "${1:-}" != "--help" ]] || {
  cat <<-EOF
	Prints which versions of the signer are deployed where and with what arguments.

	Usage: $(basename "$0") [ENVIRONMENT...]

	where ENVIRONMENT is an icp-cli environment.  Default: all environments with a signer canister ID
	in .icp/data/mappings/
	EOF

  exit 0
}

report_git_ref() {
  icp canister metadata signer git:commit -e "$ICP_ENVIRONMENT"
}
report_git_tag() {
  icp canister metadata signer git:tags -e "$ICP_ENVIRONMENT"
}
report_args() {
  icp canister call signer config '()' --query -e "$ICP_ENVIRONMENT"
}
hrule() {
  echo "########################################"
}
report() {
  hrule
  echo "environment: $ICP_ENVIRONMENT"
  echo "git ref: $(report_git_ref)"
  echo "git tag: $(report_git_tag)"
  echo "args:"
  report_args
  echo
}

if (($# > 0)); then
  ENVIRONMENTS=("${@}")
else
  readarray -t ENVIRONMENTS < <(grep -l '"signer"' .icp/data/mappings/*.ids.json | xargs -n1 basename | sed 's/[.]ids[.]json$//')
fi

for ICP_ENVIRONMENT in "${ENVIRONMENTS[@]}"; do
  report
done
