#!/usr/bin/env bash
set -euo pipefail

[[ "${1:-}" != "--help" ]] || {
  cat <<-EOF
	Prints which versions of the signer are deployed where and with what arguments.

	Usage: $(basename "$0") [ENVIRONMENT...]

	where ENVIRONMENT is an icp-cli environment.  Default: all environments with a signer canister ID
	in .icp/data/mappings/
	EOF

  exit 0
}

# The metadata is public, so it is read with the anonymous identity: loading the user's identity
# may need a password or fail on an expired delegation.
report_git_ref() {
  icp canister metadata signer git:commit -e "$ICP_ENVIRONMENT" --identity anonymous
}
report_git_tag() {
  icp canister metadata signer git:tags -e "$ICP_ENVIRONMENT" --identity anonymous
}
report_args() {
  # The signer rejects anonymous callers of `config`, so this uses the default icp-cli identity.
  icp canister call signer config '()' --query -e "$ICP_ENVIRONMENT" ||
    echo "(Could not read the config; it needs a working, non-anonymous icp-cli identity.)"
}
hrule() {
  echo "########################################"
}
report() {
  hrule
  echo "environment: $ICP_ENVIRONMENT"
  echo "git ref: $(report_git_ref)"
  echo "git tag: $(report_git_tag)"
  echo "args:"
  report_args
  echo
}

if (($# > 0)); then
  ENVIRONMENTS=("${@}")
else
  readarray -t ENVIRONMENTS < <(grep -l '"signer"' .icp/data/mappings/*.ids.json | xargs -n1 basename | sed 's/[.]ids[.]json$//')
fi

for ICP_ENVIRONMENT in "${ENVIRONMENTS[@]}"; do
  report
done
