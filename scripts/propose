#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"

print_help() {
  cat <<-EOF

	Creates an NNS proposal to upgrade the chain-fusion-signer.

	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The icp-cli environment to use" variable=ICP_ENVIRONMENT default="ic"
clap.define short=u long=nns_url desc="The NNS_URL; typically a network provider" variable=NNS_URL
clap.define short=N long=neuron desc="The neuron ID to propose with" variable=NEURON_ID
clap.define short=k long=hsm_key_id desc="The HSM key ID" variable=HSM_KEY_ID default=""
clap.define short=i long=identity desc="The icp-cli identity to use" variable=ICP_IDENTITY default="$(icp identity default)"
clap.define long=save-proposal-id-to-file desc="Create a file with this name containing the proposal ID" variable=PROPOSAL_ID_FILE default="proposal_id.txt"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

cd "${SOURCE_DIR}/.."
echo "Preparing release for environment: $ICP_ENVIRONMENT"

is_mainnet() {
  [[ "${ICP_ENVIRONMENT:-}" == "ic" ]]
}

# Prints how icp-cli stores the given identity, e.g. `{"kind": "hsm", "key-id": "01", ...}`.
# icp-cli has no command that shows this, so we read its identity list.
# See `IdentitySpec` in https://github.com/dfinity/icp-cli/blob/v1.8.0/crates/icp-app/src/identity/manifest.rs
icp_identity_spec() {
  local data_dir
  if [[ -n "${ICP_HOME:-}" ]]; then
    data_dir="$ICP_HOME"
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    data_dir="$HOME/Library/Application Support/org.dfinity.icp-cli"
  else
    data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icp-cli"
  fi
  name="$1" jq -e '.identities[env.name]' "$data_dir/identity/identity_list.json"
}

# Gets the neuron ID.
# ... if saved in a file, get it:
# The path dates from dfx; it is kept so that saved neuron IDs keep working.
NEURON_PATH="$HOME/.config/dfx/prod-neuron"
if test -e "$NEURON_PATH"; then
  NEURON_ID="$(cat "$NEURON_PATH")"
  echo "Neuron ID: $NEURON_ID (from $NEURON_PATH)"
else
  read -rp "Please enter your Neuron ID: " NEURON_ID
  read -rp "... Store the Neuron ID for future use? (y/N)" STORE_NEURON
  [[ "$STORE_NEURON" != [yY] ]] || {
    mkdir -p "$(dirname "$NEURON_PATH")"
    printf "%s" "$NEURON_ID" >"$NEURON_PATH"
  }
fi
[[ "${NEURON_ID:-}" != "" ]] || {
  echo "ERROR: Neuron ID not provided."
  exit 1
} >&2

# Gets the HSM key ID and slot, if applicable.
IDENTITY_SPEC="$(icp_identity_spec "$ICP_IDENTITY")" || {
  echo "ERROR: Unknown icp-cli identity: $ICP_IDENTITY"
  exit 1
} >&2
IDENTITY_KIND="$(jq -r .kind <<<"$IDENTITY_SPEC")"
HSM_SLOT=0
# ... from an HSM-linked icp-cli identity (`icp identity link hsm`):
if [[ "$IDENTITY_KIND" == "hsm" ]]; then
  HSM_KEY_ID="${HSM_KEY_ID:-$(jq -r '."key-id"' <<<"$IDENTITY_SPEC")}"
  HSM_SLOT="$(jq -r .slot <<<"$IDENTITY_SPEC")"
fi
# ... for mainnet we use an HSM and the key ID in the standard setup is 01:
[[ "${HSM_KEY_ID:-}" != "" ]] || {
  if is_mainnet; then
    HSM_KEY_ID="01"
  fi
}
# ... else the neuron should be controlled by the identity's key.

# Gets the authentication mechanism
if is_mainnet || [[ "${HSM_KEY_ID:-}" != "" ]]; then
  # Authenticate with an HSM
  read -rsp "HSM Pin: " HSM_PIN
  echo >&2 # `read -s` suppresses the newline the user typed.
  AUTH_ARGS=(--use-hsm --pin "$HSM_PIN" --key-id "${HSM_KEY_ID}" --slot "$HSM_SLOT")
  AUTH_ARGS_REDACTED=(--use-hsm --pin "<redacted>" --key-id "${HSM_KEY_ID}" --slot "$HSM_SLOT")
elif [[ "$IDENTITY_KIND" =~ ^(pem|keyring)$ ]]; then
  # Authenticate with the identity's key, exported to a private temporary pem file.
  # ic-admin cannot read encrypted pem files or the keyring, so we export the unencrypted key.
  PEM_PATH="$(mktemp)"
  trap 'rm -f "$PEM_PATH"' EXIT
  chmod 600 "$PEM_PATH"
  icp identity export "$ICP_IDENTITY" >"$PEM_PATH"
  AUTH_ARGS=(--secret-key-pem "$PEM_PATH")
  AUTH_ARGS_REDACTED=("${AUTH_ARGS[@]}")
else
  {
    echo "ERROR: Please specify the HSM key ID (usually 01) or use an icp-cli identity with a pem or keyring key."
    echo "       Identity '$ICP_IDENTITY' is of kind '$IDENTITY_KIND'."
    exit 1
  } >&2
fi

# Gets the chain-fusion-signer canister ID
CANISTER_ID="$(icp canister status signer -e "$ICP_ENVIRONMENT" --id-only)"
# ... just checking...
if is_mainnet; then
  [[ "${CANISTER_ID:-}" == "grghe-syaaa-aaaar-qabyq-cai" ]] || {
    echo "ERROR: Has the mainnet signer canister ID really changed?"
    echo "       If so, please update this script: '${BASH_SOURCE[0]}'"
    exit 1
  } >&2
fi

# Gets the NNS URL
[[ "${NNS_URL:-}" != "" ]] || {
  case "$ICP_ENVIRONMENT" in
  # These environments are on the `ic` network in icp.yaml.
  ic | staging | beta) NNS_URL="https://ic0.app" ;;
  local) NNS_URL="$(icp network status -e local --json | jq -r .api_url)" ;;
  esac
}
[[ "${NNS_URL:-}" != "" ]] || {
  echo "ERROR: Unable to determine the NNS URL."
  echo "       Please specify --nns_url as a command line argument."
  exit 1
} >&2

# Gets the wasm
# Note: If the wasm is not provided, the SHA will fail.
# Note: Also, the template creation script will fail if the wasm is not provided.
WASM="release/ci/signer.wasm.gz"
WASM_SHA="$(sha256sum <"$WASM" | awk '{print $1}')"

# Gets the canister upgrade argument.
# Upgrades use the network-independent `(variant { Upgrade })` argument, which tells the
# canister's post_upgrade hook to keep the existing configuration. The Init args in
# release/ci are only for the initial installation; submitting them on an upgrade would
# overwrite the whole canister config (see RELEASE.md, "Init vs Upgrade argument").
ARG_PATH=release/signer.upgrade.args.bin
build.upgrade.args.sh "release/signer.upgrade.args.did" >&2

ARG_SHA="$(sha256sum <"$ARG_PATH" | awk '{print $1}')"

# Gets the proposal text
SUMMARY_FILE=release/PROPOSAL.md
test -e "${SUMMARY_FILE:-}" || {
  echo "ERROR: Proposal text not found at: ${SUMMARY_FILE}"
  exit 1
} >&2

# Prepares the command
PROPOSAL_ARGS=(--nns-url "$NNS_URL" propose-to-change-nns-canister --proposer "$NEURON_ID" --canister-id "$CANISTER_ID" --mode upgrade --wasm-module-path "$WASM" --summary-file "$SUMMARY_FILE" --wasm-module-sha256 "$WASM_SHA" --arg "$ARG_PATH" --arg-sha256 "$ARG_SHA")
set ic-admin "${AUTH_ARGS[@]}" "${PROPOSAL_ARGS[@]}"
# ... just checking...
echo
echo PLEASE REVIEW THIS COMMAND:
echo
echo "ic-admin ${AUTH_ARGS_REDACTED[*]} ${PROPOSAL_ARGS[*]}"
echo

read -rp "Execute? (y/N) " COMMAND_OK
if [[ "$COMMAND_OK" = [yY] ]]; then
  if [[ "${PROPOSAL_ID_FILE:-}" ]]; then
    # The ic-admin command writes 1 line (among others) to stdout with the following format:
    # proposal proposal <proposal_id>
    # We want to parse the proposal ID out of that. First we tee stdout to
    # /dev/tty so the user can also see the output, then we use grep and sed to
    # extract the proposal ID and write it to a file.
    "${@}" |
      tee /dev/tty |
      (grep -E 'proposal [0-9]+' || true) |
      head -1 |
      sed -E 's/.*proposal ([0-9]+)/\1/' >"$PROPOSAL_ID_FILE"
  else
    "${@}"
  fi
fi
